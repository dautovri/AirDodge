          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo não detecta movimento da cabeça. O AirBoxer precisa de um iPhone emparelhado com %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это устройство не отслеживает движения головы. Для AirBoxer нужен iPhone, сопряженный с %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
