    "Lower = larger head movements needed (gentler on the neck). Higher = smaller movements register (faster reactions, more strain)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niedriger = größere Kopfbewegungen nötig (schont den Nacken). Höher = kleinere Bewegungen genügen (schnellere Reaktionen, anstrengender)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menor = requiere movimientos de cabeza más amplios (más suave para el cuello). Mayor = detecta movimientos más pequeños (reacciones más rápidas, más exigente)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus bas = mouvements de tête plus amples requis (plus doux pour le cou). Plus haut = détection de mouvements plus réduits (réactions plus vives, plus exigeant)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bassa = movimenti della testa più ampi (meno faticoso per il collo). Alta = movimenti più piccoli (riflessi più rapidi, più sforzo)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低い = 頭を大きく動かす必要があります（首に優しい）。高い = わずかな動きで反応します（素早い反応が可能ですが、負担が大きくなります）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "낮음 = 더 큰 머리 움직임 필요(목에 무리가 덜 감). 높음 = 작은 움직임도 인식(빠른 반응, 목에 무리가 더 감)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lager = grotere hoofdbewegingen vereist (minder zwaar voor de nek). Hoger = kleinere bewegingen tellen mee (snellere reacties, zwaarder voor de nek)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menor = movimentos de cabeça maiores necessários (mais leve pro pescoço). Maior = movimentos menores são registrados (reações mais rápidas, mais esforço)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меньше = нужны более широкие движения головой (меньше нагрузка на шею). Больше = считываются мелкие движения (быстрее реакция, выше нагрузка)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "较低 = 需要更大头部动作（对颈部负担小）。较高 = 微小动作即可识别（反应更快，负荷更大）。"
          }
        }
      }
    },
