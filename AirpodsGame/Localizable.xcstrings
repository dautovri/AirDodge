    "This device can't report head motion. AirBoxer needs an iPhone paired with %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät unterstützt keine Kopfbewegung. AirBoxer benötigt ein iPhone, das mit %@ gekoppelt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo no detecta el movimiento de la cabeza. AirBoxer necesita un iPhone enlazado con %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil ne peut pas détecter les mouvements de tête. AirBoxer nécessite un iPhone jumelé avec %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
