          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada esquiva asesta un contragolpe. Vacía su barra para ganar; si recibes cinco golpes, caes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque esquive déclenche un contre. Videz sa jauge pour gagner ; encaissez cinq coups et vous êtes K.-O."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni schivata piazza un contrattacco. Svuota la sua barra per vincere; subisci cinque colpi e sei K.O."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パンチを避けるたびにカウンターが炸裂。相手のゲージをゼロにすれば勝利、5回被弾するとダウンとなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "펀치를 피할 때마다 카운터를 날립니다. 상대 게이지를 모두 깎으면 승리하며, 5번 맞으면 다운됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke ontwijking levert een counter op. Maak hun balk leeg om te winnen; incasseer vijf klappen en je gaat neer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada esquiva acerta um contragolpe. Esvazie a barra dele para vencer; tome cinco golpes e você cai."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый уклон — это контрудар. Опустоши его шкалу для победы; пять пропущенных — и ты на полу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次闪避都能反击。清空对方血条即获胜；被击中5次则倒地。"
          }
        }
      }
    },
