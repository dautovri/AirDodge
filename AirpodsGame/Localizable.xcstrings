    "A head-tracking boxing dodge game." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Box-Ausweichspiel mit Head-Tracking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un juego de esquivas de boxeo con seguimiento de cabeza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un jeu d’esquive de boxe contrôlé par les mouvements de tête."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schiva i colpi a suon di boxe con i movimenti della testa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頭の動きでパンチを避けるボクシングゲーム。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "헤드 트래킹 복싱 회피 게임."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een boksuitwijkspel met hoofdtracking."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um jogo de boxe e esquiva com rastreamento de cabeça."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Боксерская аркада с уклонением движениями головы."
