    "Head tracking is on. Sit tall and start a session.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopferfassung ist aktiv. Sitz aufrecht und starte eine Sitzung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El seguimiento de la cabeza está activado. Siéntate erguido y empieza una sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le suivi de la tête est activé. Tenez-vous droit et lancez une session."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rilevamento della testa è attivo. Siediti con la schiena dritta e avvia una sessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘッドトラッキングがオンです。背すじを伸ばして、セッションを始めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머리 추적이 켜져 있어요. 허리를 펴고 세션을 시작해 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoofdtracking staat aan. Ga rechtop zitten en start een sessie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O rastreamento da cabeça está ativo. Sente-se com a coluna ereta e inicie uma sessão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживание головы включено. Сядь ровно и начни сессию."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "头部追踪已开启。坐直，开始一次监测吧。"
          }
        }
      }
    },
    "Head tracking on": {
      "localizations": {
