    "Slowly lower your chin toward your chest. Keep your shoulders relaxed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senke dein Kinn langsam zur Brust. Lass die Schultern locker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja despacio la barbilla hacia el pecho. Mantén los hombros relajados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaissez lentement le menton vers la poitrine. Gardez les épaules détendues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbassa lentamente il mento verso il petto. Tieni le spalle rilassate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あごをゆっくり胸のほうへ下ろします。肩の力は抜いたままにしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "턱을 가슴 쪽으로 천천히 내려요. 어깨는 편안하게 힘을 빼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat je kin langzaam naar je borst zakken. Houd je schouders ontspannen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaixe lentamente o queixo em direção ao peito. Mantenha os ombros relaxados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медленно опусти подбородок к груди. Плечи держи расслабленными."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "慢慢将下巴靠向胸口，保持肩膀放松。"
          }
        }
      }
    },
