    "Motion & Fitness access is off. Tap the status chip to open Settings and turn it on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf „Bewegung & Fitness“ ist aus. Tippe auf die Statusanzeige, um die Einstellungen zu öffnen und ihn einzuschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a Movimiento y actividad física está desactivado. Toca el indicador de estado para abrir Ajustes y activarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès à Mouvements et forme est désactivé. Touchez la pastille d'état pour ouvrir Réglages et l'activer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso a Movimento e fitness è disattivato. Tocca l'indicatore di stato per aprire Impostazioni e attivarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「モーションとフィットネス」へのアクセスがオフです。ステータス表示をタップして設定を開き、オンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'동작 및 피트니스' 접근이 꺼져 있어요. 상태 표시를 탭해 설정을 열고 켜 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot ‘Beweging en fitness’ staat uit. Tik op de statusindicator om Instellingen te openen en het aan te zetten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso a Movimento e Preparo Físico está desativado. Toque no indicador de status para abrir os Ajustes e ativá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к «Движению и фитнесу» выключен. Коснись индикатора статуса, чтобы открыть Настройки и включить его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“运动与健身”权限已关闭。轻点状态标签，打开“设置”并开启。"
          }
        }
      }
    },
