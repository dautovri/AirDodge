    "Connect %@ to this iPhone, then tap the status chip to retry." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde %@ mit diesem iPhone und tippe auf die Statusanzeige, um es erneut zu versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta %@ a este iPhone y toca el indicador de estado para reintentar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez vos %@ à cet iPhone, puis touchez l’indicateur d’état pour réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connetti %@ a questo iPhone, poi tocca lo stato per riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@をこのiPhoneに接続し、ステータスをタップして再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 기기를 이 iPhone에 연결한 후 상태 표시를 탭하여 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbind %@ met deze iPhone en tik op de statusbadge om het opnieuw te proberen."
          }
        },
        "pt-BR" : {
