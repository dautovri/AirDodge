    "Last guy he fought is still in the ring. Don't be the next one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sein letzter Gegner liegt immer noch im Ring. Sei nicht der Nächste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El último con el que peleó aún sigue en la lona. No seas el siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son dernier adversaire est encore sur le ring. Ne soyez pas le suivant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il suo ultimo avversario è ancora sul ring. Non fare la stessa fine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回の対戦相手はいまだリングの上だ。次の犠牲者になるな。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녀석과 마지막으로 싸운 상대는 아직 링에 누워 있습니다. 다음 희생양이 되지 마세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De vorige vent tegen wie hij vocht ligt nog steeds in de ring. Zorg dat jij niet de volgende bent."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O último cara que lutou com ele ainda está no ringue. Não seja o próximo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его прошлый соперник до сих пор на ринге. Не стань следующим."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上一个跟他打的人还在拳台上躺着呢。别当下一个。"
          }
        }
      }
    },
