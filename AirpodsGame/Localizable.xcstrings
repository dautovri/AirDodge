    "Free sessions stop at 10 minutes. Pro runs as long as your workday.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlose Sitzungen enden nach 10 Minuten. Mit Pro laufen sie so lange wie dein Arbeitstag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sesiones gratuitas terminan a los 10 minutos. Pro te acompaña toda tu jornada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sessions gratuites s'arrêtent à 10 minutes. Pro vous accompagne toute la journée de travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sessioni gratuite si fermano a 10 minuti. Con Pro durano quanto la tua giornata di lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料セッションは10分で終了します。Proなら仕事中ずっと使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 세션은 10분에 끝나요. Pro는 일하는 내내 계속돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis sessies stoppen na 10 minuten. Pro loopt net zo lang door als je werkdag."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As sessões gratuitas param em 10 minutos. Com o Pro, elas duram todo o seu expediente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатные сессии длятся до 10 минут. С Pro — столько, сколько длится твой рабочий день."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费监测每次 10 分钟。Pro 可陪你度过整个工作日。"
          }
        }
      }
    },
    "Gentle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanft"
          }
        },
        "es": {
          "stringUnit": {
