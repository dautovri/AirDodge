    "AirBoxer — head-tracking boxing dodge for iPhone with motion earbuds." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirBoxer – Box-Ausweichspiel mit Head-Tracking für iPhone mit Bewegungskopfhörern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirBoxer: esquivas de boxeo con seguimiento de cabeza para iPhone y auriculares con sensores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirBoxer — esquive de boxe sur iPhone par mouvements de tête avec écouteurs compatibles."
