    "Connect %@ for posture alerts and motion-checked reps. Routines also run in guided mode without them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde %@ für Haltungshinweise und bewegungsgeprüfte Wiederholungen. Routinen laufen auch ohne sie im geführten Modus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta %@ para recibir alertas de postura y repeticiones verificadas por movimiento. Sin ellos, las rutinas también funcionan en modo guiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez %@ pour recevoir des alertes de posture et faire vérifier vos répétitions par le mouvement. Sans eux, les routines fonctionnent aussi en mode guidé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega %@ per ricevere avvisi sulla postura e ripetizioni verificate dal movimento. Senza, le routine funzionano comunque in modalità guidata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を接続すると、姿勢アラートと動きの確認付きのストレッチが使えます。接続しなくても、ルーティンはガイドモードで行えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 연결하면 자세 알림과 움직임 확인 스트레칭을 쓸 수 있어요. 연결하지 않아도 루틴은 가이드 모드로 진행돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbind %@ voor houdingsmeldingen en herhalingen met bewegingscontrole. Zonder werken routines ook, in de begeleide modus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte %@ para receber alertas de postura e repetições conferidas pelo movimento. Sem eles, as rotinas também funcionam no modo guiado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключи %@, чтобы получать напоминания об осанке и проверку повторов по движению. Без них комплексы работают в режиме с подсказками."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接%@，即可获得体态提醒和动作检测。没有耳机时，练习也可在引导模式下进行。"
          }
        }
      }
    },
