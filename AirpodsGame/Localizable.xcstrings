    "Your earbuds are connected. Put them in your ears — head motion only streams while they're worn." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Kopfhörer sind verbunden. Setze sie auf – Kopfbewegungen werden nur erfasst, während sie getragen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus auriculares están conectados. Póntelos: el movimiento de la cabeza solo se transmite si los llevas puestos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écouteurs connectés. Mettez-les dans vos oreilles : les mouvements ne sont transmis que lorsqu'ils sont portés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auricolari collegati. Indossali: i movimenti della testa vengono rilevati solo quando sono alle orecchie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イヤホンが接続されました。耳に装着してください。頭の動きは装着中のみトラッキングされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이어폰이 연결되었습니다. 귀에 착용하세요. 착용 중에만 머리 움직임이 감지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je oordopjes zijn verbonden. Doe ze in je oren — hoofdbewegingen worden alleen doorgegeven als je ze draagt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus fones estão conectados. Coloque-os nos ouvidos — o movimento da cabeça só é rastreado enquanto estiverem em uso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наушники подключены. Наденьте их — движения головы отслеживаются, только когда они в ушах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "耳机已连接。请戴入耳中——仅在佩戴状态下才会传输头部动作数据。"
          }
        }
      }
    }
