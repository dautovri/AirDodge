    "Chin up. Sit tall.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinn hoch. Sitz aufrecht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta la barbilla. Siéntate erguido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relevez le menton. Tenez-vous droit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su il mento. Schiena dritta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あごを上げて、背すじを伸ばしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "턱을 들고 허리를 펴요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kin omhoog. Zit rechtop."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Queixo para cima. Coluna ereta."
          }
        },
        "ru": {
