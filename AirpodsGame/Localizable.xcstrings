    "Take your time. You can't lose." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass dir Zeit. Du kannst nicht verlieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tómate tu tiempo. No puedes perder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenez votre temps. Impossible de perdre."
          }
