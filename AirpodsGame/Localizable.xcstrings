          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Delicata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やさしめ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부드럽게"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacht"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suave"
          }
        },
        "ru": {
          "stringUnit": {
