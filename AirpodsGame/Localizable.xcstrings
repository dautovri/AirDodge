            "state": "translated",
            "value": "轻柔"
          }
        }
      }
    },
    "Gentle lowers every target angle. Never push into pain.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Sanft“ verringert jeden Zielwinkel. Dehne nie in den Schmerz hinein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suave reduce todos los ángulos objetivo. Nunca fuerces hasta sentir dolor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Douce réduit chaque angle cible. Ne forcez jamais jusqu'à la douleur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Delicata riduce ogni angolo da raggiungere. Non forzare mai fino a sentire dolore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「やさしめ」は、すべての目標角度を小さくします。痛みを感じるまで伸ばさないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'부드럽게'는 모든 목표 각도를 낮춰요. 통증이 느껴질 만큼 무리하지 마세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Zacht’ verkleint elke doelhoek. Rek nooit door tot het pijn doet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suave reduz todos os ângulos-alvo. Nunca force até sentir dor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Щадящая» уменьшает все целевые углы. Никогда не тянись через боль."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“轻柔”会降低所有目标角度。感到疼痛时切勿勉强。"
          }
        }
      }
    },
