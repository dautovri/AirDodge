        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서는 머리 움직임을 감지할 수 없습니다. AirBoxer를 플레이하려면 %@와 페어링된 iPhone이 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
