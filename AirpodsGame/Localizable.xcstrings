    "Stay loose. Don't tense up. He's more nervous than you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleib locker. Nicht verkrampfen. Er ist nervöser als du."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantente suelto. No te tenses. Está más nervioso que tú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restez souple. Ne vous crispez pas. Il a plus le trac que vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilassati. Non irrigidirti. È più nervoso di te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リラックスして。緊張しないで。相手のほうが緊張しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "긴장 풀어요. 굳지 마요. 상대가 더 긴장하고 있으니까요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blijf ontspannen. Niet verkrampen. Hij is zenuwachtiger dan jij."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique relaxado. Não fique tenso. Ele está mais nervoso que você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расслабьтесь. Не напрягайтесь. Он нервничает больше вас."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放松点，别绷太紧。他比你还紧张呢。"
          }
        }
      }
    },
