    "This iPhone can't read head motion. Routines still run in guided mode with on-screen timing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone kann keine Kopfbewegungen erfassen. Routinen laufen trotzdem im geführten Modus mit Zeitangaben auf dem Bildschirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone no puede leer el movimiento de la cabeza. Las rutinas siguen funcionando en modo guiado, con los tiempos en pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone ne peut pas lire les mouvements de la tête. Les routines restent disponibles en mode guidé, avec un minutage à l'écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo iPhone non può leggere i movimenti della testa. Le routine funzionano comunque in modalità guidata, con i tempi sullo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneでは頭の動きを読み取れません。ルーティンは、画面のタイマーに合わせて進むガイドモードで行えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에서는 머리 움직임을 읽을 수 없어요. 루틴은 화면 타이머에 맞춰 진행되는 가이드 모드로 할 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze iPhone kan geen hoofdbewegingen uitlezen. Routines werken nog steeds in de begeleide modus met timing op het scherm."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone não consegue ler o movimento da cabeça. As rotinas ainda funcionam no modo guiado, com o tempo na tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот iPhone не может считывать движения головы. Комплексы всё равно работают в режиме с подсказками и таймером на экране."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 无法读取头部动作。练习仍可在引导模式下进行，由屏幕计时。"
          }
        }
      }
    },
