    "Just feel the rhythm. Slip, duck, slip." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finde einfach den Rhythmus. Ausweichen, ducken, ausweichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue el ritmo: esquiva, agáchate, esquiva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez le rythme. Décalez, baissez-vous, décalez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segui il ritmo. Schiva, abbassati, schiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リズムを感じろ。スリップ、ダック、スリップ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "리듬을 타세요. 슬립, 더킹, 슬립."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voel gewoon het ritme. Ontwijk, buk, ontwijk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinta o ritmo. Esquive, abaixe, esquive."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просто чувствуй ритм. Уклон, нырок, уклон."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感受节奏就好。偏头、下潜、偏头。"
          }
        }
      }
    },
