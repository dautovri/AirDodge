    "If you see his eyes glow, the next telegraph is half as long." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn seine Augen leuchten, kündigt er den nächsten Schlag nur halb so lang an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si le brillan los ojos, el aviso del siguiente golpe durará la mitad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ses yeux brillent, le temps d'anticipation du prochain coup est réduit de moitié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se i suoi occhi brillano, il prossimo colpo arriva al doppio della velocità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目が光ったら、次の攻撃の予兆は半分の短さになる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녀석의 눈이 번쩍이면 다음 예비 동작 시간이 절반으로 줄어듭니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als zijn ogen oplichten, is zijn volgende telegraaf half zo lang."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se os olhos dele brilharem, o próximo aviso de golpe será na metade do tempo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если у него загорелись глаза, замах перед следующим ударом будет вдвое короче."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你看到他双眼发光，下一次前摇时间减半。"
          }
        }
      }
    },
